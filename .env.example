# Required: Reddit API credentials (create at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Required: OpenRouter API key for LLM inference
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override Grok Alpha model routing
# GROK_MODEL=x-ai/grok-4.1
# GROK_FALLBACK_MODELS=x-ai/grok-4.1-fast
# GROK_TIMEOUT_SECONDS=55

# Required: Secret token to authenticate webhook calls
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Notion Integration Token (for publishing to Notion)
# Create at: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here

# Optional: Override the default Notion database ID
# NOTION_DATABASE_ID=21d90be5f44d80ffa169cbb40567085b

# Optional: Skip Notion publishing
# SKIP_NOTION=true
